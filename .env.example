DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snp
SESSION_SECRET=change-me-to-a-long-random-string
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# Microsoft Entra ID (Azure AD) SSO — set all four to enable "Sign in with Microsoft".
# The redirect URI must exactly match a Redirect URI registered in the Azure app.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=https://your-app.up.railway.app/auth/microsoft/callback
MS_SCOPES=User.Read
